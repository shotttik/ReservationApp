						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"if (pm.response.code === 200) {\r",
									"    if (jsonData.accessToken && jsonData.refreshToken) {\r",
									"        pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);\r",
									"        pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);\r",
									"        \r",
									"        console.log(\"Tokens updated successfully.\");\r",
									"    } else {\r",
									"        console.warn(\"Tokens not found in response.\");\r",
									"    }\r",
									"} else {\r",
									"    console.error(\"API call failed. Tokens not updated.\");\r",
									"}\r",
									"\r",
									"pm.test(\"Verify tokens exist in the response\", function () {\r",
									"    pm.expect(jsonData.accessToken).to.exist;\r",
									"    pm.expect(jsonData.refreshToken).to.exist;\r",
