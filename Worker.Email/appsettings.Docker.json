{
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 465,
    "Username": "mail",
    "Password": "password",
    "Name": "Reservation App"
  },
  "RabbitMQ": {
    "Host": "rabbitmq", 
    "Port": 5672,
    "Username": "app", 
    "Password": "AppPass123!", 
    "VirtualHost": "/", 
    "ExchangeName": "notifications.exchange",
    "EmailQueue": "email_queue",
    "SmsQueue": "sms_queue"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Logs/log-.txt",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7,
                  "shared": true,
                  "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [CorrelationId={CorrelationId}] [Source={SourceContext}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ],
    "Properties": { "Application": "ReservationApp" }
  }
}
